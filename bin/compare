#!/usr/bin/env bash
# One comparison, end to end: run both systems, score the answers, build the
# side-by-side page. Every knob is a flag, so a sweep never needs a new config.
#
#   bin/compare --config experiments/configs/series_abcd.yaml \
#               --question b2_tsr_cdss_reaction --question b3_bureau_during_reaction \
#               --repeats 1 --case-id 366132845011
#
# Several cases in one run — every question is asked about every case, and the
# page gets a case selector:
#
#   bin/compare --config experiments/configs/series_abcd.yaml \
#               --case-id 366132845011 --case-id '11854808010 '
#   bin/compare --config experiments/configs/series_abcd.yaml \
#               --cases-from ../AgenticSys_v2/data_tables/real
#
# Quote a case id: one of the real case folders ends in a space, and the id
# must keep it to match the case on disk.
#
# Cheap end-to-end check before spending on a full pass — a saved selection
# from `experiment.scopes`, so it is one word rather than a line of flags:
#
#   bin/compare --config experiments/configs/series_abcd.yaml --scope smoke \
#               --cases-from ../AgenticSys_v2/data_tables/real
#
# `smoke` there is 4 questions across 3 sets at k=2 over both cases — 32
# records against the full run's 216, and still enough to exercise the per-set
# tables and the case and repeat tabs. Read it as a check, not a measurement.
#
# To measure a SUBSET instead, use a question scope: it narrows what is asked
# and leaves k and the cases as the config has them.
#
#   bin/compare --config experiments/configs/series_abcd.yaml \
#               --question-scope series_b
#
# Finish (or redo) the judging on a run already on disk, starting no system at
# all. This RESUMES: answers already judged are kept and only the missing ones
# cost anything, so an interrupted pass is cheap to complete.
#
#   bin/compare --config experiments/configs/series_abcd.yaml --skip-run \
#               --runs experiments/results/<run>/runs.jsonl
#
# Anything not passed falls back to the config. `--question` and `--case-id`
# may repeat; an unknown question fails before either system starts, as does a
# follow-up selected without the turn it refers to.
set -euo pipefail

# This repo's own .env first — a copy placed here is meant to be used, and
# ../AgenticSys_v2/.env is resolved from the CALLER's cwd, so it silently
# missed whenever bin/compare ran from anywhere else.
CONFIG="" ; ARGS=()
ENV_FILE="${AGENTIC_EVAL_ENV:-}"
if [[ -z "$ENV_FILE" ]]; then
  for candidate in "$(dirname "${BASH_SOURCE[0]}")/../.env" "../AgenticSys_v2/.env"; do
    [[ -f "$candidate" ]] && { ENV_FILE="$candidate"; break; }
  done
fi
SKIP_RUN=0 ; RUNS=""

# Prefer the installed console script; fall back to running the package out of
# this checkout. `pip install -e .` is one step to forget, and the failure was
# a bare "agentic-eval: command not found" that says nothing about which of the
# two Pythons it went missing from. The repo root comes from this script's own
# location, so the fallback works from any cwd.
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if command -v agentic-eval >/dev/null 2>&1; then
  EVAL=(agentic-eval)
else
  EVAL=("${AGENTIC_EVAL_PYTHON:-python3}" -m agentic_eval)
  export PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}"
  "${EVAL[@]}" --help >/dev/null 2>&1 || {
    echo "cannot run agentic-eval: neither the console script nor" >&2
    echo "  ${AGENTIC_EVAL_PYTHON:-python3} -m agentic_eval (from $REPO) works." >&2
    echo "  Try: ${AGENTIC_EVAL_PYTHON:-python3} -m pip install -e $REPO" >&2
    exit 2; }
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)      CONFIG="$2"; ARGS+=(--config "$2"); shift 2 ;;
    --env-file)    ENV_FILE="$2"; shift 2 ;;
    --runs)        RUNS="$2"; shift 2 ;;
    --question|--scope|--question-scope|--case-id|--cases-from|--repeats|--workers|--mode|--baseline-cwd|--candidate-cwd)
                   ARGS+=("$1" "$2"); shift 2 ;;
    --skip-run)    SKIP_RUN=1; shift ;;
    # Print the header block, however long it grows: everything from line 2
    # up to the first non-comment line. A pinned range silently truncates the
    # help the moment a paragraph is added above it.
    -h|--help)     sed -n '2,/^[^#]/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *)             echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done
[[ -n "$CONFIG" ]] || { echo "--config is required" >&2; exit 2; }

# Sourced BEFORE the plan, because the env file is where LLM_BACKEND lives in
# the private environment, and the transport decides whether a key is needed.
if [[ -f "$ENV_FILE" ]]; then set -a; . "$ENV_FILE"; set +a; fi

echo "== plan"
# One validate call feeds both the plan and the key check. It needs no
# credentials, so it can run before them.
PLAN=$("${EVAL[@]}" validate "${ARGS[@]}")
printf '%s' "$PLAN" | python3 -c '
import json,sys; d=json.load(sys.stdin)
cases = d.get("cases") or []
sets = d.get("question_sets") or {}
print("   %d records over %s, %d question(s) in %d set(s), %d case(s), %d worker(s)" % (
    d.get("planned_records", 0), d.get("mode", "?"),
    len(d.get("questions") or []), max(1, len(sets)),
    max(1, len(cases)), d.get("workers", 1)))
print("   judge: %s via %s" % (d["content_evaluation"]["model"],
                               d["content_evaluation"]["backend"]))
for name, qs in sets.items():
    print("     set %s: %d questions" % (name, len(qs)))
for case in cases:
    print("     case %s" % (repr(case) if case != case.strip() else case))'

# Only the OpenAI transport needs a key. SafeChain authenticates through the
# gateway, and demanding OPENAI_API_KEY there refused to start a run that
# never had anything to send to OpenAI.
BACKEND=$(printf '%s' "$PLAN" \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["content_evaluation"]["backend"])')
if [[ "$BACKEND" != safechain ]]; then
  : "${OPENAI_API_KEY:?set it, or point --env-file at a file that does}"
fi

if (( SKIP_RUN )); then
  # Re-judge answers already on disk. The flag used to be parsed and then
  # ignored, so `--skip-run` started both systems and ran the whole thing —
  # the one outcome it exists to prevent.
  [[ -n "$RUNS" ]] || {
    echo "--skip-run needs --runs <path to runs.jsonl>" >&2; exit 2; }
  [[ -f "$RUNS" ]] || { echo "no such runs file: $RUNS" >&2; exit 2; }
  OUT=$(cd "$(dirname "$RUNS")" && pwd)
  echo "== skip run; scoring the answers already in $OUT"
else
  echo "== run"
  OUT=$("${EVAL[@]}" run "${ARGS[@]}" | tee /dev/stderr | tail -1 | sed 's/^Comparison complete: //')
fi

echo "== score answers"
# --resume when working on a run that already exists. Judging is the expensive
# half — hundreds of calls against a slow gateway — and a pass that died at
# answer 180 should cost minutes to finish, not another full spend. On a fresh
# run the directory is empty, so it changes nothing there.
#
# NOT passed after a fresh run: `evaluate-content` would then have nothing to
# resume anyway, and leaving it off keeps re-judging from scratch available by
# re-invoking with --skip-run absent.
SCORE=(evaluate-content --config "$CONFIG" --runs "$OUT/runs.jsonl" --output-dir "$OUT")
(( SKIP_RUN )) && SCORE+=(--resume)
"${EVAL[@]}" "${SCORE[@]}" | tail -1

cat <<EOF

== results in $OUT
  runs.jsonl                     one record per answer: the answer, the team, the
                                 evidence ledger, tokens, latency, memory offered
  content/evaluations.jsonl      one record per answer, scored: claims, per-claim
                                 grounding and routes, must-haves, oracles, metrics
  content/answer_comparison.html the page — metrics first, then answers side by
                                 side with their claims and markers; case and
                                 repeat selectors switch which answers are shown
  content/walkthrough.md         the same, as text: answer -> claims -> numbers
  content/comparison.md          one scorecard table, both systems, every question
  content/summary.json           aggregated metrics, for a script to read
  metrics/                       consistency, memory and latency, per question
  logs/                          each system's server log for the run
EOF
